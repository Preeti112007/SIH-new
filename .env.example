# Environment variables for AICTE Unified Case Coordination Radar
# -----------------------------------------------------------------------------
# Default zero-dependency local demonstration configuration:
# Uses SQLite for immediate out-of-the-box testing without requiring a running PostgreSQL server.
DATABASE_URL="file:./dev.db"

# To switch to an enterprise PostgreSQL instance:
# 1. Update the provider in prisma/schema.prisma to "postgresql"
# 2. Uncomment and configure the PostgreSQL connection string below:
# DATABASE_URL="postgresql://aicte_user:aicte_secure_pass@localhost:5432/aicte_radar?schema=public"

# Application Settings
NEXT_PUBLIC_APP_NAME="AICTE Unified Case Coordination Radar"
NEXT_PUBLIC_APP_SUBTITLE="Explainable Institution Identity Matching, Cross-Bureau Case Intelligence, and Multilingual Grievance Support"
NEXT_PUBLIC_DEMO_MODE="true"

# BHASHINI API Integration (Optional sandbox keys)
BHASHINI_API_KEY=""
BHASHINI_USER_ID=""
BHASHINI_PIPELINE_ENDPOINT=""
